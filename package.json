{
  "name": "jungle-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": { "bun": ">=1.4.4 <2" },
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "db:migrate": "bun scripts/migrate.ts up",
    "db:rollback": "bun scripts/migrate.ts down",
    "check:bootstrap": "bun scripts/check-bootstrap.ts"
  },
  "dependencies": {
    "@mikro-orm/core": "6.6.8",
    "@mikro-orm/postgresql": "6.6.8",
    "@mikro-orm/migrations": "6.6.8",
    "@mikro-orm/nestjs": "6.1.1",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "decimal.js": "10.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.3",
    "typescript": "5.9.3"
  }
}
